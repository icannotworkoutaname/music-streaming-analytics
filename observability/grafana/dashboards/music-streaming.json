{
  "title": "Music Streaming Analytics",
  "uid": "music-streaming",
  "schemaVersion": 38,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Events Ingested Rate (per second)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(events_ingested_total[1m])",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Queries Executed Rate (per second)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(queries_executed_total[1m])",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Windows Emitted Rate (per second)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(windows_emitted_total[1m])",
          "legendFormat": "{{metric}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Request Rate by Service",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "{{application}} {{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Error Rate (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(http_server_requests_seconds_count{status=~\"4..|5..\"}[1m])",
          "legendFormat": "{{application}} {{status}} {{uri}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Kafka Messages Sent Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(spring_kafka_template_seconds_count{result=\"success\"}[1m])",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ]
}
